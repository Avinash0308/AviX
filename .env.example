# Environment Variables for Genius.ai / AviX

# Clerk Authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# Google Gemini API (Chatbot & Code)
API_KEY=

# Replicate API (Images, Music, Video)
REPLICATE_API_TOKEN=

# Database (PostgreSQL)
DATABASE_URL="postgresql://user:password@localhost:5432/avix"

# Stripe (Billing & Subscriptions)
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=

# App URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Cloudinary (Persistent media storage for Images, Audio, Video)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
